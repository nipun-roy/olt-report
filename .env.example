# Turso Database Configuration
# 1. Create a database using Turso CLI:
#    turso db create olt-manager-db
# 2. Get your DB URL:
#    turso db show olt-manager-db --url
# 3. Create an Auth Token:
#    turso db tokens create olt-manager-db

TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optical Alert Threshold (default: 24.0 dB)
NEXT_PUBLIC_DEFAULT_THRESHOLD="24.0"
